# Optional: the frontend normally fetches the VAPID public key at runtime
# from GET /api/push/vapid-public-key, so this is only a fallback used if
# that request fails (e.g. static hosting without the API reachable yet).
# Must match VAPID_PUBLIC_KEY in backend/.env.
VITE_VAPID_PUBLIC_KEY=

# Production only — set as a build-time env var on your hosting platform
# (e.g. Cloudflare Pages), not in this file. Not VITE_-prefixed on purpose:
# it's read by vite.config.ts during the Node build process to generate a
# same-origin API proxy (_redirects), not bundled into client code. See
# docs/DEPLOYMENT.md.
# API_ORIGIN=https://your-backend.onrender.com
