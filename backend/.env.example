DATABASE_URL="postgresql://user:password@localhost:5432/taskmanager"
PORT=5000
JWT_SECRET="replace-with-a-long-random-string"
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"
# Get a free key at https://brevo.com (Settings -> SMTP & API -> API Keys) —
# leave unset to log verification/invitation emails to the console instead
# of sending them. Most PaaS hosts (Render included) block outbound SMTP,
# which is why this uses an HTTPS-based provider rather than Gmail SMTP.
# EMAIL_FROM's address must be verified as a sender in Brevo (Settings ->
# Senders & IP -> Senders) before sends will succeed.
BREVO_API_KEY=
EMAIL_FROM="Taskly <onboarding@yourdomain.com>"
# Web Push VAPID keypair — generate your own with `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY must also be set as VITE_VAPID_PUBLIC_KEY in frontend/.env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@example.com"
# How often (ms) the reminder dispatch worker polls for due reminders.
REMINDER_POLL_INTERVAL_MS=30000
# Cloudflare R2 (or any S3-compatible) object storage for uploaded files and
# avatars. Leave all four unset for local dev — falls back to local disk
# automatically. Required in production on hosts with ephemeral disk (most
# free tiers wipe local files on every restart/redeploy). See docs/DEPLOYMENT.md.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# AI Assistant (daily planner / smart search / AI task creation / project
# summary) — get a free key at https://aistudio.google.com/apikey. Leave
# unset to disable the feature (the endpoints return a clear 503 instead of
# failing oddly). GEMINI_MODEL defaults to "gemini-flash-latest" if unset.
GEMINI_API_KEY=
GEMINI_MODEL=
