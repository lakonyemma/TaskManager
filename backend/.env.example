DATABASE_URL="postgresql://user:password@localhost:5432/taskmanager"
PORT=5000
JWT_SECRET="replace-with-a-long-random-string"
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"
# Gmail SMTP for transactional email (verification, invitations). Leave any
# of these unset to log emails to the console instead of sending them.
# SMTP_USER is the full Gmail address; SMTP_PASS must be a 16-character App
# Password (https://myaccount.google.com/apppasswords), not the account
# password — Gmail requires 2FA to be enabled to generate one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Taskly <your-address@gmail.com>"
# Web Push VAPID keypair — generate your own with `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY must also be set as VITE_VAPID_PUBLIC_KEY in frontend/.env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@example.com"
# How often (ms) the reminder dispatch worker polls for due reminders.
REMINDER_POLL_INTERVAL_MS=30000
# Cloudflare R2 (or any S3-compatible) object storage for uploaded files and
# avatars. Leave all four unset for local dev — falls back to local disk
# automatically. Required in production on hosts with ephemeral disk (most
# free tiers wipe local files on every restart/redeploy). See docs/DEPLOYMENT.md.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
