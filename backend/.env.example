DATABASE_URL="postgresql://user:password@localhost:5432/taskmanager"
PORT=5000
JWT_SECRET="replace-with-a-long-random-string"
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"
# Get a free key at https://brevo.com (Settings -> SMTP & API -> API Keys) —
# leave unset to log verification/invitation emails to the console instead
# of sending them. Most PaaS hosts (Render included) block outbound SMTP,
# which is why this uses an HTTPS-based provider rather than Gmail SMTP.
# EMAIL_FROM's address must be verified as a sender in Brevo (Settings ->
# Senders & IP -> Senders) before sends will succeed.
BREVO_API_KEY=
EMAIL_FROM="Taskly <onboarding@yourdomain.com>"
# Web Push VAPID keypair — generate your own with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@example.com"
REMINDER_POLL_INTERVAL_MS=30000
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Taskly Premium billing via Flutterwave
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET_HASH=
# Optional Flutterwave payment-plan ID for automatic recurring card billing.
# Create a monthly Premium payment plan in Flutterwave and put its ID here.
FLW_PREMIUM_PAYMENT_PLAN_ID=
# Local monthly Premium price. Uganda uses UGX. USD is the fallback for other countries.
TASKLY_PREMIUM_MONTHLY_UGX=
TASKLY_PREMIUM_MONTHLY_USD=5
