generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"

}

model User {
  id                         String    @id @default(uuid())
  firstname                  String
  lastName                   String
  email                      String    @unique
  password                   String
  avatarUrl                  String?
  bio                        String?
  isActive                   Boolean   @default(true)
  isSuperAdmin               Boolean   @default(false)
  language                   String    @default("en")
  fontStyle                  String    @default("default")
  colorTheme                 String    @default("purple")
  taskNotificationsEnabled   Boolean   @default(true)
  emailNotificationsEnabled  Boolean   @default(true)
  emailVerified              Boolean   @default(false)
  emailVerifiedAt            DateTime?
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?
  appLockEnabled             Boolean   @default(false)
  appLockPinHash             String?
  appLockTimeoutMinutes      Int       @default(5)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  workspaceMembers       WorkspaceMember[]
  assignedTasks          Task[]                  @relation("AssignedTasks")
  completedTasks         Task[]                  @relation("CompletedTasks")
  activityLogs           ActivityLog[]
  notifications          Notification[]
  workspaceInvitations   WorkspaceInvitation[]   @relation("InvitedBy")
  sessions               Session[]
  comments               Comment[]
  files                  File[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  reminderSchedules      ReminderSchedule[]
  userAchievements       UserAchievement[]
  savedViews             SavedView[]
  focusSessions          FocusSession[]
  timeEntries            TimeEntry[]
  sentAnnouncements      PlatformAnnouncement[]
  gmailConnections       GmailConnection[]
  mailActionItems        MailActionItem[]
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id          String        @id @default(uuid())
  name        String
  description String?
  type        WorkspaceType @default(PERSONAL)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks         Task[]
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  files         File[]
  tags          Tag[]
  savedViews    SavedView[]
  boardColumns  BoardColumn[]
  milestones    Milestone[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Task {
  id                         String          @id @default(uuid())
  title                      String
  description                String?
  notes                      String?
  priority                   TaskPriority    @default(MEDIUM)
  status                     TaskStatus      @default(TODO)
  dueDate                    DateTime?
  completedAt                DateTime?
  completedById              String?
  estimatedMinutes           Int?
  columnId                   String?
  milestoneId                String?
  clientId                   String?         @unique
  workspaceId                String
  assignedToId               String?
  parentTaskId               String?
  isRecurring                Boolean         @default(false)
  recurrenceRule             RecurrenceRule?
  recurrenceInterval         Int?
  recurrenceDaysOfWeek       Int[]           @default([])
  recurrenceBusinessDaysOnly Boolean         @default(false)
  recurrenceEndDate          DateTime?
  recurrenceCount            Int?
  recurrenceOccurrenceNumber Int             @default(1)
  recurrenceParentId         String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo        User?              @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy       User?              @relation("CompletedTasks", fields: [completedById], references: [id], onDelete: SetNull)
  column            BoardColumn?       @relation(fields: [columnId], references: [id], onDelete: SetNull)
  milestone         Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  activityLogs      ActivityLog[]
  notifications     Notification[]
  comments          Comment[]
  files             File[]
  reminderSchedules ReminderSchedule[]
  tags              Tag[]              @relation("TaskTags")
  focusSessions     FocusSession[]
  timeEntries       TimeEntry[]
  mailActionItems   MailActionItem[]

  parentTask Task?  @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[] @relation("Subtasks")

  recurrenceParent   Task?  @relation("RecurrenceChain", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren Task[] @relation("RecurrenceChain")

  dependsOn Task[] @relation("TaskDependencies")
  blocks    Task[] @relation("TaskDependencies")

  relatedTo   Task[] @relation("TaskRelated")
  relatedFrom Task[] @relation("TaskRelated")

  @@index([workspaceId, status])
  @@index([assignedToId, status])
  @@index([completedById, status])
  @@index([workspaceId, dueDate])
  @@index([columnId])
  @@index([milestoneId])
}

model BoardColumn {
  id           String     @id @default(uuid())
  workspaceId  String
  name         String
  color        String     @default("#8b5cf6")
  order        Int
  mapsToStatus TaskStatus @default(TODO)
  createdAt    DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
}

model Milestone {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  description String?
  dueDate     DateTime?
  order       Int       @default(0)
  achievedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
}

model Tag {
  id          String   @id @default(uuid())
  name        String
  color       String   @default("#8b5cf6")
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]    @relation("TaskTags")

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model SavedView {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  name        String
  filters     Json
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId])
}

model FocusSession {
  id              String   @id @default(uuid())
  userId          String
  taskId          String
  durationSeconds Int
  pomodoroCount   Int      @default(0)
  startedAt       DateTime
  endedAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt])
  @@index([taskId])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  body      String
  mentions  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TimeEntry {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  minutes   Int
  note      String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, loggedAt])
}

model File {
  id           String   @id @default(uuid())
  workspaceId  String
  taskId       String?
  uploadedById String
  filename     String
  storedName   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id            String   @id @default(uuid())
  action        String
  entityType    String?
  entityId      String?
  userId        String
  workspaceId   String?
  taskId        String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id                 String           @id @default(uuid())
  userId             String
  workspaceId        String?
  taskId             String?
  reminderScheduleId String?
  type               NotificationType
  message            String
  isRead             Boolean          @default(false)
  createdAt          DateTime         @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task             Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reminderSchedule ReminderSchedule? @relation(fields: [reminderScheduleId], references: [id], onDelete: SetNull)
}

model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id                     String           @id @default(uuid())
  userId                 String           @unique
  pushEnabled            Boolean          @default(true)
  soundEnabled           Boolean          @default(true)
  vibrationEnabled       Boolean          @default(true)
  defaultReminderMinutes Int[]            @default([15])
  digestFrequency        DigestFrequency  @default(OFF)
  lastDigestSentAt       DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GmailConnection {
  id                   String   @id @default(uuid())
  userId               String
  email                String
  accessTokenEnc       String
  refreshTokenEnc      String?
  tokenExpiresAt       DateTime?
  historyId            String?
  unreadCount          Int      @default(0)
  monitoringEnabled    Boolean  @default(true)
  digestEnabled        Boolean  @default(true)
  digestHour           Int      @default(8)
  followUpDays         Int      @default(3)
  timezone             String   @default("UTC")
  lastSyncedAt         DateTime?
  lastDigestAt         DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailActionItems MailActionItem[]

  @@unique([userId, email])
  @@index([userId])
}

model MailActionItem {
  id                String           @id @default(uuid())
  userId            String
  gmailConnectionId String
  gmailMessageId    String
  threadId          String
  counterparty      String?
  subject           String
  snippet           String
  receivedAt        DateTime
  unread            Boolean          @default(false)
  kind              MailActionKind
  confidence        Int              @default(50)
  detectedDueAt     DateTime?
  status            MailActionStatus @default(OPEN)
  taskId            String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailConnection GmailConnection @relation(fields: [gmailConnectionId], references: [id], onDelete: Cascade)
  task            Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([gmailConnectionId, gmailMessageId])
  @@index([userId, status, receivedAt])
  @@index([gmailConnectionId, status, receivedAt])
  @@index([gmailConnectionId, threadId])
  @@index([taskId])
}

model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  icon        String
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model ReminderSchedule {
  id            String         @id @default(uuid())
  taskId        String
  userId        String
  offsetMinutes Int?
  remindAt      DateTime
  label         String
  status        ReminderStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([status, remindAt])
  @@index([taskId])
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
  SNOOZED
}

model WorkspaceInvitation {
  id          String           @id @default(uuid())
  email       String
  workspaceId String
  invitedById String
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  role        WorkspaceRole    @default(MEMBER)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([email, workspaceId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model PlatformAnnouncement {
  id         String   @id @default(uuid())
  title      String
  message    String
  sentById   String
  recipients Int      @default(0)
  createdAt  DateTime @default(now())

  sentBy User @relation(fields: [sentById], references: [id], onDelete: Cascade)
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum RecurrenceRule {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_UPDATED
  TASK_DELETED
  TASK_COMPLETED
  MENTION
  PROJECT_UPDATED
  WORKSPACE_INVITED
  DUE_DATE_REMINDER
  SYSTEM_ANNOUNCEMENT
}

enum DigestFrequency {
  OFF
  DAILY
  WEEKLY
}

enum MailActionKind {
  ACTION_REQUIRED
  DEADLINE
  WAITING_REPLY
}

enum MailActionStatus {
  OPEN
  TASK_CREATED
  WAITING_CREATED
  DONE
  DISMISSED
}
