generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"

}

model User {
  id                         String    @id @default(uuid())
  firstname                  String
  lastName                   String
  email                      String    @unique
  password                   String
  avatarUrl                  String?
  bio                        String?
  isActive                   Boolean   @default(true)
  // Platform-wide role, orthogonal to per-workspace WorkspaceRole — a
  // super admin manages the platform itself (users, workspaces, system
  // health) and isn't necessarily a member of any given workspace.
  isSuperAdmin               Boolean   @default(false)
  language                   String    @default("en")
  fontStyle                  String    @default("default")
  colorTheme                 String    @default("purple")
  taskNotificationsEnabled   Boolean   @default(true)
  emailNotificationsEnabled  Boolean   @default(true)
  emailVerified              Boolean   @default(false)
  emailVerifiedAt            DateTime?
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?
  // App Lock — a local re-authentication gate distinct from the account
  // password (see settings/appLockController.ts). appLockPinHash is a
  // bcrypt hash, never the raw PIN. Biometric ("Fingerprint"/"Face")
  // unlock is out of scope for now — a browser can only expose that via
  // WebAuthn, which authenticates the device's platform authenticator, not
  // a value Taskly could store/compare like a PIN.
  appLockEnabled             Boolean   @default(false)
  appLockPinHash             String?
  appLockTimeoutMinutes      Int       @default(5)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  workspaceMembers       WorkspaceMember[]
  assignedTasks          Task[]                  @relation("AssignedTasks")
  completedTasks         Task[]                  @relation("CompletedTasks")
  activityLogs           ActivityLog[]
  notifications          Notification[]
  workspaceInvitations   WorkspaceInvitation[]   @relation("InvitedBy")
  sessions               Session[]
  comments               Comment[]
  files                  File[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  reminderSchedules      ReminderSchedule[]
  userAchievements       UserAchievement[]
  savedViews             SavedView[]
  focusSessions          FocusSession[]
  timeEntries            TimeEntry[]
  sentAnnouncements      PlatformAnnouncement[]
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id          String        @id @default(uuid())
  name        String
  description String?
  type        WorkspaceType @default(PERSONAL)
  // Platform admin kill switch — a disabled workspace's members keep their
  // membership rows (nothing is deleted) but every workspace-scoped action
  // is blocked (see utils/membership.ts).
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks         Task[]
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  files         File[]
  tags          Tag[]
  savedViews    SavedView[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Task {
  id                         String          @id @default(uuid())
  title                      String
  description                String?
  // Free-form scratchpad distinct from `description` — meant for jottings
  // made *while working* (e.g. in Focus Mode), not the task's definition.
  notes                      String?
  priority                   TaskPriority    @default(MEDIUM)
  status                     TaskStatus      @default(TODO)
  dueDate                    DateTime?
  completedAt                DateTime?
  // Who actually marked the task complete — distinct from assignedToId.
  // Achievements/insights credit this, not the assignee: a solo user very
  // often completes tasks they never bothered to explicitly assign to
  // themselves, and assignment tracks delegation/ownership, not who did
  // the work of finishing it.
  completedById              String?
  estimatedMinutes           Int?
  // Client-generated idempotency key for offline-created tasks — lets the
  // sync layer safely retry a "create" mutation (e.g. after a dropped
  // response) without producing a duplicate task.
  clientId                   String?         @unique
  workspaceId                String
  assignedToId               String?
  parentTaskId               String?
  isRecurring                Boolean         @default(false)
  recurrenceRule             RecurrenceRule?
  // Recurrence engine config (only meaningful when isRecurring is true).
  // interval multiplies the base unit ("every N days/weeks/months/years");
  // daysOfWeek (0=Sun..6=Sat) restricts a WEEKLY rule to specific weekdays;
  // businessDaysOnly skips generated occurrences that land on a weekend.
  recurrenceInterval         Int?
  recurrenceDaysOfWeek       Int[]           @default([])
  recurrenceBusinessDaysOnly Boolean         @default(false)
  recurrenceEndDate          DateTime?
  recurrenceCount            Int?
  recurrenceOccurrenceNumber Int             @default(1)
  recurrenceParentId         String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo        User?              @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy       User?              @relation("CompletedTasks", fields: [completedById], references: [id], onDelete: SetNull)
  activityLogs      ActivityLog[]
  notifications     Notification[]
  comments          Comment[]
  files             File[]
  reminderSchedules ReminderSchedule[]
  tags              Tag[]              @relation("TaskTags")
  focusSessions     FocusSession[]
  timeEntries       TimeEntry[]

  parentTask Task?  @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[] @relation("Subtasks")

  recurrenceParent   Task?  @relation("RecurrenceChain", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren Task[] @relation("RecurrenceChain")

  dependsOn Task[] @relation("TaskDependencies")
  blocks    Task[] @relation("TaskDependencies")

  // Purely informational cross-link — no blocking/completion semantics, no
  // cycle checks (unlike dependsOn/blocks). Undirected in spirit: a link is
  // stored once (via relatedTo) but the UI/API reads both fields together so
  // it shows up from either task.
  relatedTo   Task[] @relation("TaskRelated")
  relatedFrom Task[] @relation("TaskRelated")

  @@index([workspaceId, status])
  @@index([assignedToId, status])
  @@index([completedById, status])
  @@index([workspaceId, dueDate])
}

// A workspace-scoped, reusable tag — replaces the earlier free-text
// Task.labels string array (which had no UI, no reuse/autocomplete, and no
// way to rename/delete a tag everywhere it was used at once).
model Tag {
  id          String   @id @default(uuid())
  name        String
  color       String   @default("#8b5cf6")
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]    @relation("TaskTags")

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// A user's personal saved task-list filter (e.g. "Due This Week", "High
// Priority") — private to the user who created it, scoped to one workspace.
// `filters` mirrors the frontend's task-filter shape ({kind, status?,
// tagId?, priority?}) as opaque JSON rather than a fixed set of columns, so
// new filter kinds don't need a migration to become saveable.
model SavedView {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  name        String
  filters     Json
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId])
}

// One row per completed stretch of focused time on a task (Focus Mode) —
// logged when the user exits Focus Mode or a Pomodoro focus interval
// finishes, whichever comes first. Powers "focus history" and the
// analytics dashboard's time-on-task figures. Break time is never logged.
model FocusSession {
  id              String   @id @default(uuid())
  userId          String
  taskId          String
  durationSeconds Int
  pomodoroCount   Int      @default(0)
  startedAt       DateTime
  endedAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt])
  @@index([taskId])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  body      String
  mentions  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Manually logged (or timer-derived) actual time spent on a task — distinct
// from Task.estimatedMinutes (a plan) and FocusSession (Focus Mode/Pomodoro
// specific, capped at 4h, break time excluded). A TimeEntry is just "N
// minutes were spent on this task", optionally with a note, so it also
// covers work done entirely outside Focus Mode.
model TimeEntry {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  minutes   Int
  note      String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, loggedAt])
}

model File {
  id           String   @id @default(uuid())
  workspaceId  String
  taskId       String?
  uploadedById String
  filename     String
  storedName   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

// Doubles as both the collaboration "Activity Feed" (task/comment/project
// events — see /api/activity) and, for the security-relevant entityTypes
// (login, logout, password_changed, account_changed, role_changed, etc.),
// the source for /api/audit-logs. previousValue/newValue capture a
// structured before/after diff where one applies (e.g. {role: "MEMBER"} ->
// {role: "ADMIN"}) — never populated for password changes, which log the
// event only, on purpose.
model ActivityLog {
  id            String   @id @default(uuid())
  action        String
  entityType    String?
  entityId      String?
  userId        String
  workspaceId   String?
  taskId        String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id                 String           @id @default(uuid())
  userId             String
  workspaceId        String?
  taskId             String?
  reminderScheduleId String?
  type               NotificationType
  message            String
  isRead             Boolean          @default(false)
  createdAt          DateTime         @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task             Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reminderSchedule ReminderSchedule? @relation(fields: [reminderScheduleId], references: [id], onDelete: SetNull)
}

// One row per device/browser a user has granted Web Push permission on.
// `endpoint` is globally unique per browser installation, so it doubles as
// the natural upsert key when a client re-subscribes.
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id                     String           @id @default(uuid())
  userId                 String           @unique
  pushEnabled            Boolean          @default(true)
  soundEnabled           Boolean          @default(true)
  vibrationEnabled       Boolean          @default(true)
  defaultReminderMinutes Int[]            @default([15])
  // "Here's what's due" email — off by default so opting in is a deliberate
  // choice, not something everyone gets by default. digestWorker.ts polls
  // for who's due one and uses lastDigestSentAt to avoid re-sending within
  // the same period (24h for DAILY, 7d for WEEKLY) if the worker restarts.
  digestFrequency        DigestFrequency  @default(OFF)
  lastDigestSentAt       DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Static catalog of achievements (streaks, milestones). Seeded idempotently
// at server boot (see achievementService.ensureAchievementsSeeded) rather
// than requiring a manual seed run, so the catalog is always present.
model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  icon        String
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

// One row per (user, achievement) the user has actually earned — earning is
// permanent once granted, so this doubles as the "earned at" audit record.
model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// A single scheduled reminder for one user on one task. Offset-based
// reminders (5m/10m/.../1d before) store `offsetMinutes` so they can be
// recomputed if the due date changes; fully custom reminders leave it null
// and `remindAt` is authoritative.
model ReminderSchedule {
  id            String         @id @default(uuid())
  taskId        String
  userId        String
  offsetMinutes Int?
  remindAt      DateTime
  label         String
  status        ReminderStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([status, remindAt])
  @@index([taskId])
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
  SNOOZED
}

model WorkspaceInvitation {
  id          String           @id @default(uuid())
  email       String
  workspaceId String
  invitedById String
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  role        WorkspaceRole    @default(MEMBER)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([email, workspaceId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// A platform-wide broadcast sent by a super admin. Fans out to a
// SYSTEM_ANNOUNCEMENT Notification per user at send time (see
// features/admin/adminController.ts) — this row is the durable record for
// the admin dashboard's "sent announcements" history, not itself the
// delivery mechanism.
model PlatformAnnouncement {
  id         String   @id @default(uuid())
  title      String
  message    String
  sentById   String
  recipients Int      @default(0)
  createdAt  DateTime @default(now())

  sentBy User @relation(fields: [sentById], references: [id], onDelete: Cascade)
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum RecurrenceRule {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_UPDATED
  TASK_DELETED
  TASK_COMPLETED
  MENTION
  PROJECT_UPDATED
  WORKSPACE_INVITED
  DUE_DATE_REMINDER
  SYSTEM_ANNOUNCEMENT
}

enum DigestFrequency {
  OFF
  DAILY
  WEEKLY
}
